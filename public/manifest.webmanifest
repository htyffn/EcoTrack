{
  "name": "EcoTrack - Sistema de Gestión de Residuos",
  "short_name": "EcoTrack",
  "description": "Aplicación PWA para gestionar residuos y promover prácticas sostenibles",
  "display": "standalone",
  "scope": "./",
  "start_url": "./",
  "theme_color": "#2d5a3d",
  "background_color": "#ffffff",
  "orientation": "portrait-primary",
  "categories": ["productivity", "utilities"],
