  "shortcuts": [
    {
      "name": "Registrar residuo",
      "short_name": "Nuevo residuo",
      "description": "Registrar un nuevo tipo de residuo rápidamente",
      "url": "./waste?action=new",
      "icons": [
        {
          "src": "icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ver residuos",
      "short_name": "Mis residuos",
      "description": "Ver lista de residuos registrados",
      "url": "./waste?action=list",
      "icons": [
        {
          "src": "icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/waste?action=shared",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
