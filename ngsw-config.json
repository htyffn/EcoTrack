{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "cacheQueryOptions": {
        "ignoreVary": true
      },
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "cacheQueryOptions": {
        "ignoreVary": true
      },
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ],
        "urls": [
          "https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/**/*"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "waste-data",
      "urls": ["/api/waste/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 100,
        "maxAge": "1d"
      }
    },
    {
      "name": "api-fallback",
      "urls": ["/api/**"],
      "cacheConfig": {
        "strategy": "network-first",
        "timeout": 5000,
        "maxSize": 100,
        "maxAge": "2d"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.",
    "!/**/*__*"
  ]
}
